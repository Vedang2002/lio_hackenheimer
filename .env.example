# Copy this file to .env and fill in your own values. Never commit .env.

# The customer portal (required)
SOONY_PORTAL_URL=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net
SOONY_API_TOKEN=

# OpenAI (required). The fallback key takes over when the first runs out of credit.
OPENAI_API_KEY=
OPENAI_API_KEY_FALLBACK=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AGENT_MODEL=gpt-5.4

# The agents. Exactly one running copy may have AGENTS=on.
AGENTS=off
AUTO_SEND=inquiries
DAILY_BUDGET_USD=5
HOURLY_BUDGET_USD=1

# The agents' mailbox. Filled in by: uv run python -m app.gmail_auth
MAIL_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Access to the desk. Required on a public deployment.
APP_ACCESS_KEY=
# Optional personal keys: [{"name": "...", "key": "...", "role": "viewer|approver|admin", "limit_eur": 50000}]
APP_USERS=

# Optional Postgres address; the state is saved there and restored after a restart.
DATABASE_URL=
